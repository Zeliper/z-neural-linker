# 빌더의 "시험 실행" 이 진짜 HTTP 서버를 열고 응답하는지 끝까지 확인한다.
#
#   tools/uitest/uitest.sh start
#   UITEST_FRESH=1 tools/uitest/uitest.sh run tools/uitest/scenarios/pipeline.uit
#   tools/uitest/uitest.sh stop
#
# 다른 시나리오가 화면 모양을 보는 것과 달리 이쪽은 **동작**을 본다. 빌더에서 돌린 파이프라인이
# 배포판과 같은 `Runner` 를 쓰므로, 여기서 200 이 나오면 그 경로 전체가 살아 있다는 뜻이다.
#
# ## 왜 `wait-log` 를 안 쓰나
#
# 빌더는 파이프라인 로그를 **앱 안 로그 패널**에만 쌓고 표준 오류로 내보내지 않는다. 그래서
# `wait-log "HTTP 서버 … 열림"` 으로는 서버가 떴는지 알 수 없다. 대신 포트를 직접 본다 —
# 어차피 확인하려는 것이 "정말 듣고 있는가" 이므로 로그보다 곧은 신호다.
#
# ## 포트
#
# 샘플의 추론 API 는 `127.0.0.1:8799` 로 고정돼 있다. 남이 쓰고 있으면 그 서버에 대고 시험하게 되어
# 통과해도 의미가 없으므로 시작하자마자 비어 있는지 본다.

# ── 좌표·시간 상수 ───────────────────────────────────────────────
# 뷰 전환·선택 뒤 다시 그려질 때까지.
set SETTLE 1.2
# 샘플 추론 API 의 고정 포트.
set PORT 8799
# 열 프로젝트. `--write-sample` 로 미리 만들어 둔다. 명령줄에서 `PROJ=…` 로 덮어쓸 수 있다.
set PROJ /tmp/uit-xor.nlproj
# 파이프라인 목록에서 "추론 API" 항목. 두 파이프라인 모두 접힌 상태의 두 번째 줄이다.
set API_X 70
set API_Y 388
# 툴바의 시험 실행 / 정지 버튼. 실행 중에는 같은 자리가 "정지" 로 바뀌는데 글자 폭이 달라
# 중심이 조금 왼쪽으로 간다.
set RUN_X 757
set RUN_Y 76
set STOP_X 741
# "전체 보기" 버튼. 캡처 직전에 한 번 눌러 캔버스 확대율을 고정한다.
set FIT_X 568
# 캡처 전에 커서를 치워 두는 자리. 호버 강조도 툴팁도 뜨지 않는 빈 곳이다.
set PARK_X 800
set PARK_Y 850
# 골든 영역: 로그 패널과 상태바 위까지만. 그 둘에는 실행마다 달라지는 시간·주파수가 들어간다.
set BODY 0,60 1600x800

# ── 시작 전 확인 ─────────────────────────────────────────────────
expect-port-free $PORT

# ── 열 문서 준비 ─────────────────────────────────────────────────
# 시나리오가 스스로 입력을 갖춘다. 파일 대화상자를 피하려고 앱에 인자로 넘긴다.
write-sample $PROJ xor

# ── 앱 띄우기 ────────────────────────────────────────────────────
app $PROJ
wait-app
wait-log "\[nl-app\] ready" 30
wait-log "\[nl-app\] focused" 30
# 포커스 직후 키보드가 다시 만들어지는 구간이 지나기를 기다린다. 이걸 안 기다리면 Ctrl+4 가 사라진다.
wait-log "\[nl-app\] input ready" 30
# 장치 확인이 끝나야 상태바와 모델 준비가 안정된다. 드라이버가 깨진 GPU 를 훑느라 오래 걸릴 수 있다.
wait-log "\[nl-app\] devices ready" 180

# ── 파이프라인 뷰로 ──────────────────────────────────────────────
# `key` + `wait-log` 대신 `key-until` 을 쓴다. 컴포지터가 가상 키보드를 다시 만드는 구간에 걸리면
# 키가 조용히 사라지는데, 마커를 기다리기만 하면 그대로 실패한다(5회 중 1회 겪었다).
key-until "\[nl-app\] view 파이프라인" -s 200 -M ctrl -k 4 -m ctrl -s 250
move $PARK_X $PARK_Y
sleep $SETTLE

# ── "추론 API" 고르기 ────────────────────────────────────────────
# 왼쪽 목록에서 고른다. 툴바 콤보의 팝업은 떴다 사라지는 타이밍을 타서 좌표가 흔들린다.
click $API_X $API_Y
move $PARK_X $PARK_Y
sleep $SETTLE

# ── 시험 실행 ────────────────────────────────────────────────────
click $RUN_X $RUN_Y
# 서버가 실제로 듣기 시작할 때까지. 모델을 올리는 동안에도 포트는 먼저 열린다.
wait-port $PORT 30

# ── 진짜 요청 ────────────────────────────────────────────────────
# 학습된 가중치가 없어 숫자는 무작위 초기화 결과다. 값이 아니라 **모양**을 본다 —
# 배열이 돌아오면 소스 → 모델 → 싱크가 끝까지 이어진 것이다.
http POST http://127.0.0.1:$PORT/infer [1,0]
expect-http 200 "^\[.*\]$"

# ── 정지 ─────────────────────────────────────────────────────────
click $STOP_X $RUN_Y
# 포트가 풀리는 것이 곧 파이프라인이 멈췄다는 뜻이다.
wait-port-free $PORT 30

# ── 캡처 전에 캔버스를 고정 ──────────────────────────────────────
# 캔버스는 보이는 크기에 맞춰 확대율을 잡는데, 실행을 시작하면 아래 로그 패널이 열리면서
# 그 크기가 바뀐다. 패널이 열린 시점이 맞춤보다 앞이냐 뒤냐에 따라 노드가 몇 픽셀씩 달라져
# 골든이 흔들렸다(실제로 2.7% 차이로 헛실패했다). 여기서 한 번 맞춰 두면 언제 열렸든 같아진다.
click $FIT_X $RUN_Y
move $PARK_X $PARK_Y
sleep $SETTLE

# 노드에 붙은 마지막 값 배지까지 들어간다. 가중치가 무작위 초기화이긴 하지만 시드가 고정이라
# 실행마다 같은 숫자가 나온다 — 세 번 연속 0.000% 로 일치하는 것을 확인했다.
# 가중치를 학습해 넣거나 시드를 바꾸면 이 골든을 다시 만들어야 한다.
expect-shot pipeline-stopped $BODY
