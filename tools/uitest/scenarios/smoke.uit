# 빌더의 뷰 전환 연기 시험. 각 뷰를 골든 이미지와 견준다.
#
#   UITEST_FRESH=1 tools/uitest/uitest.sh run tools/uitest/scenarios/smoke.uit
#
# 허용 오차는 기본값(`UITEST_TOLERANCE=0.5`, `UITEST_PIXEL_DELTA=8`)으로 세 번 연속 통과했다.
# 자원 뷰(07)에는 CPU·메모리 수치와 그래프가 들어가 실행마다 조금씩 달라진다. 그 화면 때문에
# 헛실패가 나면 `UITEST_TOLERANCE=1.0` 정도까지 올려도 뷰가 바뀐 것은 여전히 잡힌다.
#
# 골든이 없으면 첫 실행이 만들고 "골든 생성" 으로 알린다. 만들어진 PPM 을 눈으로 확인한 뒤
# 커밋해야 다음 실행부터 실제 비교가 된다. 갱신 절차는 tools/uitest/README.md 참고.
#
# 뷰 전환은 앱이 찍는 `[nl-app] view <이름>` 마커를 기다린다. 로그는 앱을 띄울 때마다 비워지지만
# 한 시나리오 안에서 같은 뷰로 두 번 가면 두 번째 대기는 이전 줄을 보고 바로 지나간다 —
# 이 시나리오는 뷰마다 한 번씩만 간다.

# ── 좌표·시간 상수 ───────────────────────────────────────────────
# 뷰를 바꾼 뒤 다시 그려질 때까지.
set SETTLE 1.2
# 클릭 전 여유. `expect-shot` 이 grim 으로 여러 장 찍은 직후라 시스템이 바쁘다.
set BEFORE_KEY 0.3
# 뷰 바 버튼의 y 좌표. x 는 아래에 버튼마다 박혀 있다.
set VIEWBAR_Y 45
# 캡처 전에 커서를 치워 두는 자리. 어느 뷰에서도 비어 있는 지점이라 호버 강조도 툴팁도 뜨지 않는다.
# 커서를 버튼 위에 둔 채로 찍으면 툴팁이 뜨는 타이밍에 따라 골든이 흔들린다.
set PARK_X 800
set PARK_Y 850
# 뷰 바 아래 중앙 영역만 견주고 싶을 때 쓰는 예시 영역 (지금은 전체를 본다).
set BODY 0,80 1600x920

# ── 앱 띄우기 ────────────────────────────────────────────────────
# 인자로 `.nlproj` 를 주면 그 문서를 연다. 인자가 없으면 빈 프로젝트로 시작한다.
app
wait-app
# 첫 화면이 그려질 때까지. 장치 확인은 백그라운드로 빠졌으므로 1~2초면 온다.
wait-log "\[nl-app\] ready" 30
# 화면이 그려진 것과 입력을 받을 수 있는 것은 다르다. 컴포지터가 포커스를 주기 전에 보낸
# 입력은 그냥 사라진다.
wait-log "\[nl-app\] focused" 30
# 포커스 직후 키보드가 다시 만들어지는 구간이 지나기를 기다린다.
wait-log "\[nl-app\] input ready" 30
# 장치 확인이 끝나면 상태바의 "장치 확인 중…" 이 실제 이름으로 바뀐다. 골든에 상태바가 들어가므로
# 여기서 한 번 맞춰 둔다. 드라이버가 깨진 GPU 를 훑느라 20초 넘게 걸릴 수 있어 넉넉히 잡는다.
wait-log "\[nl-app\] devices ready" 180
move $PARK_X $PARK_Y
sleep $SETTLE

# 시작 화면 전체.
expect-shot 01-start

# ── 뷰 전환 (뷰 바 클릭) ─────────────────────────────────────────
# 여기서는 단축키 대신 클릭을 쓴다. `expect-shot` 이 화면을 여러 장 찍은 직후에 보낸 키는
# 가끔 컴포지터에 닿기 전에 사라진다 (wtype 은 가상 키보드를 만들자마자 키를 보내고 지운다).
# 이 시나리오가 보는 것은 화면 모양이라 전환 수단은 상관없다.
# 단축키 경로 자체는 startup.uit 가 확인한다.
sleep $BEFORE_KEY
click 70 $VIEWBAR_Y
# 전환이 실제로 일어났는지 앱이 찍는 마커로 본다. 고정 대기만 쓰면 놓친 전환이 골든이 된다.
wait-log "\[nl-app\] view 데이터" 10
move $PARK_X $PARK_Y
sleep $SETTLE
expect-shot 02-view2

sleep $BEFORE_KEY
click 116 $VIEWBAR_Y
# 전환이 실제로 일어났는지 앱이 찍는 마커로 본다. 고정 대기만 쓰면 놓친 전환이 골든이 된다.
wait-log "\[nl-app\] view 학습" 10
move $PARK_X $PARK_Y
sleep $SETTLE
expect-shot 03-view3

sleep $BEFORE_KEY
click 172 $VIEWBAR_Y
# 전환이 실제로 일어났는지 앱이 찍는 마커로 본다. 고정 대기만 쓰면 놓친 전환이 골든이 된다.
wait-log "\[nl-app\] view 파이프라인" 10
move $PARK_X $PARK_Y
sleep $SETTLE
expect-shot 04-view4

sleep $BEFORE_KEY
click 230 $VIEWBAR_Y
# 전환이 실제로 일어났는지 앱이 찍는 마커로 본다. 고정 대기만 쓰면 놓친 전환이 골든이 된다.
wait-log "\[nl-app\] view GUI" 10
move $PARK_X $PARK_Y
sleep $SETTLE
expect-shot 05-view5

sleep $BEFORE_KEY
click 267 $VIEWBAR_Y
# 전환이 실제로 일어났는지 앱이 찍는 마커로 본다. 고정 대기만 쓰면 놓친 전환이 골든이 된다.
wait-log "\[nl-app\] view 빌드" 10
move $PARK_X $PARK_Y
sleep $SETTLE
expect-shot 06-view6

sleep $BEFORE_KEY
click 307 $VIEWBAR_Y
# 전환이 실제로 일어났는지 앱이 찍는 마커로 본다. 고정 대기만 쓰면 놓친 전환이 골든이 된다.
wait-log "\[nl-app\] view 자원" 10
move $PARK_X $PARK_Y
sleep $SETTLE
expect-shot 07-view7

# 첫 뷰로 돌아와 시작 화면과 같은지 본다.
sleep $BEFORE_KEY
click 24 $VIEWBAR_Y
# 전환이 실제로 일어났는지 앱이 찍는 마커로 본다. 고정 대기만 쓰면 놓친 전환이 골든이 된다.
wait-log "\[nl-app\] view 모델" 10
move $PARK_X $PARK_Y
sleep $SETTLE
expect-shot 08-back-to-start
