# 시작이 장치 확인을 기다리지 않는지, 그 사이에도 뷰 단축키가 먹는지.
#
#   UITEST_FRESH=1 tools/uitest/uitest.sh run tools/uitest/scenarios/startup.uit
#
# 골든은 쓰지 않는다 — 여기서 보는 것은 화면 모양이 아니라 "언제 쓸 수 있게 되는가" 다.
# 장치 열거와 자동 선택은 백그라운드 스레드에서 돈다. 드라이버가 깨진 GPU 가 있으면 그 확인만
# 10초 넘게 걸리는데, 그동안에도 창은 떠 있고 입력을 받아야 한다.

app
wait-app
# 첫 화면. 장치 확인을 기다리지 않으므로 1~2초면 온다.
wait-log "\[nl-app\] ready" 20
# 화면이 그려진 것과 키를 받을 수 있는 것은 다르다. 컴포지터가 포커스를 주기 전에 보낸 키는 사라진다.
wait-log "\[nl-app\] focused" 20
# 포커스 직후에도 컴포지터가 키보드를 다시 만드는 구간이 있어 그 사이 키가 한 번 더 사라진다.
# 앱이 자리를 잡은 뒤 이 줄을 찍는다 — 첫 회차에서 Ctrl+1 이 유실되던 것이 이 구간이었다.
wait-log "\[nl-app\] input ready" 20
# 그래도 하네스를 막 띄운 회차에서는 첫 키가 사라지는 일이 있다. 컴포지터가 가상 키보드를 등록하는
# 타이밍이라 앱 마커만으로는 못 덮는다 — 아래 `key-until` 이 결과를 보고 다시 보낸다.

# 장치 확인이 아직 도는 중에 단축키를 넣는다. 예전에는 이 시점에 UI 가 통째로 멎어 키가 버려졌다.
# `-s` 는 wtype 이 가상 키보드를 만들고 지우기 전에 쉬는 시간이다. 그래도 닿지 않으면 `key-until` 이
# 결과를 보고 다시 보낸다 — 뷰 전환은 여러 번 눌러도 결과가 같다.
key-until "\[nl-app\] view 데이터" -s 200 -M ctrl -k 2 -m ctrl -s 250

# 모델 뷰로 돌아온다. 시작 뷰가 모델이므로 이 줄이 처음 나오는 "view 모델" 이다.
sleep 0.5
key-until "\[nl-app\] view 모델" -s 200 -M ctrl -k 1 -m ctrl -s 250

# 확인이 끝나면 상태바가 "장치 확인 중…" 에서 실제 이름으로 바뀐다.
wait-log "\[nl-app\] devices ready" 90
