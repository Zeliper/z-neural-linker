# 배포 앱을 헤드리스 서버로 상시 운영하는 systemd 유닛 템플릿.
#
# 사용자 유닛으로 쓰는 것이 기본이다 — 루트가 필요 없고, 앱이 쓰는 것이 전부 홈 아래에 있다.
#   install.sh --service          ~/.config/systemd/user/ 에 넣고 enable --now 까지 한다
#   systemctl --user status neural-linker-app
#   journalctl --user -u neural-linker-app -f
#
# 시스템 유닛으로 돌리려면 /etc/systemd/system/ 에 두고 User=·Group=·WorkingDirectory= 를 채운 뒤
# ProtectHome= 를 형편에 맞게 정한다. 사용자 유닛에서는 ProtectHome 이 홈을 통째로 가려 쓸 수 없다.
#
# %h 는 systemd 가 홈 경로로 바꿔 준다. 앱 이름이 다르면 ExecStart 와 EnvironmentFile 을 함께 고친다.

[Unit]
Description=Neural Linker 배포 앱 (헤드리스)
Documentation=file://%h/.local/share/doc/neural-linker/GUIDE.md
# 네트워크 소스·싱크를 쓰면 주소가 붙은 뒤에 떠야 한다.
After=network-online.target
Wants=network-online.target
# 짧은 주기로 계속 죽으면 포기한다 — 죽는 줄 모르고 로그만 쌓이는 것을 막는다.
# (이 둘은 [Service] 가 아니라 [Unit] 에 있어야 한다.)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# 토큰 같은 비밀은 유닛 파일에 적지 않는다 — 유닛은 0644 로 읽히고 `systemctl cat` 에 그대로 나온다.
# 아래 파일을 0600 으로 두고 `NL_HTTP_TOKEN=...` 한 줄을 넣는다. 없으면 조용히 넘어간다(앞의 `-`).
EnvironmentFile=-%h/.config/neural-linker/app.env

# GPU 는 헤드리스 서버에서 드라이버·권한 문제를 일으키기 쉽다. 필요할 때만 --device 를 바꾼다.
ExecStart=%h/.local/bin/내앱 --headless --device cpu

# 실패로 끝났을 때만 다시 띄운다. 정상 종료(Ctrl+C·SIGTERM)는 그대로 둔다.
Restart=on-failure
RestartSec=5s

# 종료 신호를 받으면 파이프라인을 정지하고 빠져나간다. 모델을 내리는 시간이 필요해 넉넉히 준다.
KillSignal=SIGTERM
TimeoutStopSec=30

# ── 최소 권한 ────────────────────────────────────────────────────────
# 앱은 자기 작업 폴더(무작위 이름 0700 임시 폴더)와 설정·캐시만 쓰면 된다.
NoNewPrivileges=yes
# PrivateTmp 와 ProtectSystem 은 **함께** 켜야 한다. strict 는 /tmp 까지 읽기 전용으로 만드는데
# 배포 앱은 시작할 때 임시 작업 폴더를 만든다 — PrivateTmp 가 쓰기 가능한 /tmp 를 따로 달아 준다.
# strict 만 켜면 `Read-only file system (os error 30) at path "/tmp/nl-runtime-…"` 로 즉시 죽는다(실측).
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
# ↑ wgpu·JIT 경로가 쓰기+실행 매핑을 요구할 수 있어 켜지 않는다. CPU 전용이면 yes 로 좁혀도 된다.

# ProtectSystem=strict 는 /usr·/etc 를 읽기 전용으로 만든다. 앱이 써야 하는 곳만 되돌린다.
# 앞의 `-` 는 "없으면 넘어가라" 다. 없는 경로를 적으면 서비스가 아예 뜨지 않는다
# (`Failed to set up mount namespacing: … No such file or directory`, 실측).
ReadWritePaths=-%h/.local/share/neural-linker
ReadWritePaths=-%h/.cache/neural-linker
# 앱 실행 파일과 데이터는 홈 아래에 둔다. PrivateTmp 때문에 /tmp 아래 경로는 서비스에서 보이지 않는다.

# 네트워크를 쓰지 않는 파이프라인이면 아래 두 줄을 켜서 더 좁힐 수 있다.
#RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
#IPAddressDeny=any

[Install]
WantedBy=default.target
